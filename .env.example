# Meta / Instagram Webhook
META_VERIFY_TOKEN=your_custom_verification_string
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN=your_page_access_token

# Groq (Whisper transcription + Llama summarisation)
GROQ_API_KEY=gsk_your_groq_api_key

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# Instagram cookies for yt-dlp (Netscape format)
# Export from your browser using a cookie extension, then set the path.
# Required — Instagram blocks unauthenticated yt-dlp requests.
IG_COOKIES_PATH=/app/cookies.txt
